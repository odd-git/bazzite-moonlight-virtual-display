#!/bin/bash
# Virtual display for Moonlight, run by Sunshine (global_prep_cmd) and at Sunshine start (systemd drop-in).
# Usage: moonlight-display on|off
#
# The GNOME portal permission is tied to the monitors being shared: one token for the laptop panel only
# (.edp), one for the virtual display (.dp2). With a missing or revoked token GNOME opens a permission
# dialog and the stream hangs until someone answers it.
CONNECTOR=DP-2   # must match CONNECTOR in virtual-display.sh
GRACE=120        # seconds disconnected (without Quit) before giving the laptop back; reconnecting resets it
D=~/.var/app/dev.lizardbyte.app.Sunshine/config/sunshine
T=$D/portal_token

# Whatever is in $T and is not the virtual display token is the current laptop token
# (if GNOME revoked it and you granted the permission again, Sunshine saved a new one).
save_edp() { cmp -s "$T" "$T.dp2" || cp "$T" "$T.edp"; }

case "$1" in
  on)  [[ -f $T.dp2 ]] || { echo "missing $T.dp2: grant the portal permission with $CONNECTOR on first" >&2; exit 1; }
       save_edp
       # Only the virtual display stays on: with the laptop panel next to it, games (XWayland) end up split
       # across both screens. gdctl without -P doesn't save the layout: once the virtual display is gone,
       # GNOME goes back to the laptop-only layout by itself.
       cp "$T.dp2" "$T" && sudo -n /usr/local/sbin/virtual-display.sh on && sleep 2 \
         && gdctl set --logical-monitor --primary --monitor "$CONNECTOR" || exit 1
       # Safety net for the whole session, as a transient service (systemd cleans up tail when it exits).
       systemd-run --user --quiet --collect "$0" watch "$(wc -l < "$D/sunshine.log")" ;;
  watch) # $2 = log line where this session starts. Gives the laptop back when:
         # - no capture of the virtual display within 20 s (e.g. a permission dialog nobody can see);
         # - the client disconnected without Quit: Sunshine runs undo only on Quit, so nobody else would.
    start=$SECONDS found= gone=
    while :; do
      if IFS= read -r -t 5 line; then
        case $line in
          *"Found stream for display id/name: '$CONNECTOR'"*) found=1 ;;
          *"CLIENT DISCONNECTED"*) gone=$SECONDS ;;
          *"CLIENT CONNECTED"*)    gone= ;;
        esac
      fi
      grep -q '^connected' /sys/class/drm/card*-"$CONNECTOR"/status || exit 0   # off already ran (Quit)
      [[ -z $found && $((SECONDS-start)) -ge 20 ]] && { "$0" off; exit; }
      [[ -n $gone && $((SECONDS-gone)) -ge $GRACE ]] && { "$0" off; exit; }
    done < <(tail -n +"$2" -F "$D/sunshine.log" 2>/dev/null) ;;
  off) save_edp; cp "$T.edp" "$T"; sudo -n /usr/local/sbin/virtual-display.sh off ;;
  *)   echo "usage: $0 on|off" >&2; exit 1 ;;
esac
